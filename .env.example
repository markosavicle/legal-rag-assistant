# Pick ONE provider block, uncomment it, and leave the others commented out.
# Switching embedding models later needs a fresh database: docker compose down -v

# --- Option 1: Google Gemini (free tier, recommended for testing) ------------
# Free API key: https://aistudio.google.com/apikey
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=
# Free tier: gemini-3.5-flash allows only 20 requests a day; the lite model allows far more.
CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=3072
# Free tier allows 100 embedding requests per minute; each chunk counts as one.
EMBEDDING_REQUESTS_PER_MINUTE=90
CHAT_REQUESTS_PER_MINUTE=8

# --- Option 2: Ollama (free, runs locally, no key) ---------------------------
# Install from ollama.com, then: ollama pull llama3.2:3b && ollama pull bge-m3
# From Docker use host.docker.internal; when running uvicorn directly use localhost.
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=
# CHAT_MODEL=llama3.2:3b
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIM=1024

# --- Option 3: OpenAI (paid) -------------------------------------------------
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# --- Option 4: Azure OpenAI (takes precedence when the endpoint is set) -------
# EMBEDDING_MODEL and CHAT_MODEL must be your deployment names.
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21

CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5

# Protect the API (e.g. when n8n or anything else on the network calls it): clients send it as X-API-Key.
# Generate one with: openssl rand -hex 32
API_KEY=
