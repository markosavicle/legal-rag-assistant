# Option A: OpenAI
OPENAI_API_KEY=

# Option B: Azure OpenAI (takes precedence when the endpoint is set).
# EMBEDDING_MODEL and CHAT_MODEL must then be your deployment names.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHAT_MODEL=gpt-4o-mini

CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
